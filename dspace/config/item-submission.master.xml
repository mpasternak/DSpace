<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE item-submission SYSTEM "item-submission.dtd" [
    <!ENTITY submission-map SYSTEM "item-submission-parts/submission-map.xml">
    <!ENTITY step-definitions SYSTEM "item-submission-parts/step-definitions.xml">
    <!ENTITY submission-definitions SYSTEM "item-submission-parts/submission-definitions.xml">
]>

<!-- Configurable Submission configuration file -->

<!-- This XML configuration file allows you to configure the ordering -->
<!-- and number of the steps that occur in the Item Submission Process. -->
<item-submission>

    <!-- The process-map maps collection handles to a particular Item -->
    <!-- Submission Process. This requires that a collection's name be -->
    <!-- unique, even within a community. DSpace does however ensure that each -->
    <!-- collection's handle is unique. Process-map provides the means to -->
    <!-- associate a unique collection name with an Item Submission process. -->
    <!-- The process-map also provides the special handle "default" (which is -->
    <!-- never a collection), here mapped to "traditional". Any collection -->
    <!-- which does not appear in this map will be associated with the mapping -->
    <!-- for handle "default". -->
    &submission-map;



    <!-- The 'step-definitions' allows you to define steps which you may wish -->
    <!-- to "share" amongst multiple submission-item definitions. In order to -->
    <!-- share the same step definition, you can refer to it by its unique id -->
    <!-- defined in this section. EVERY 'step' in this section MUST have a -->
    <!-- unique identifier in the 'id' attribute! -->
    <!-- -->
    <!-- Each <step-definition> REQUIRES the following attributes (@) and properties: -->
    <!-- @id - The unique identifier for this step -->
    <!-- -->
    <!-- <processing-class> - The class which will process all information for -->
    <!-- this step. The class must implement -->
    <!-- 'org.dspace.app.rest.submit.RestProcessingStep' -->
    <!-- (or one of the org.dspace.rest.submit.step.* classes) -->
    <!-- This property should reference the full path of the class -->
    <!-- (e.g. org.dspace.app.rest.submit.step.DescribeStep) -->
    <!-- This property is REQUIRED for all steps! -->
    <!-- -->
    <!-- The following properties are OPTIONAL for each <step-definition>: -->
    <!-- <heading> - References the message key, from the i18n file for the -->
    <!-- configuration specified in 'config.default.locale' -->
    <!-- (dspace.cfg). Message keys are of the form: -->
    <!-- "submit.progressbar.<stepname>" -->
    <!-- (e.g. submit.progressbar.describe) -->
    <!-- <type> - The string that defines the type of the current step. This -->
    <!-- type is used by the submission UI to properly render the step. -->
    &step-definitions;


    <!-- The submission-definitions map lays out the detailed definition of -->
    <!-- all the Item Submission Processes (step-by-step). -->
    <!-- -->
    <!-- Each "submission-process" has a unique name as an attribute, used to -->
    <!-- associate it with collections or communities in the <submission-map>. -->
    <!-- -->
    <!-- Each <submission-process> contains an ordered set of steps. Steps -->
    <!-- MUST have a <step> element, which references the unique "id" -->
    <!-- attribute of a step defined in the <step-definitions> section. Steps -->
    <!-- MAY include an optional <heading> element to specify the step's label -->
    <!-- in the progress bar (defaults to the step-definition's heading if not -->
    <!-- provided). -->
    <!-- -->
    <!-- For special use cases, a step element MAY be directly embedded in the -->
    <!-- submission-process (instead of referring to a step-definition by id). -->
    <!-- In this case, the step element MUST include all required child -->
    <!-- elements (as defined above in <step-definitions>). However, this is -->
    <!-- NOT recommended as it prevents sharing/reuse of steps across -->
    <!-- submission processes. Ideally, all steps should be defined in -->
    <!-- <step-definitions> and referenced by id. -->
    <!-- -->
    <!-- Each step-definition should also be referenced in a <submission-definitions> element. -->
    <!-- This is the "submission-process" that each collection or community uses (as -->
    <!-- be defined in <step-definitions> above). -->
    &submission-definitions;

</item-submission>
