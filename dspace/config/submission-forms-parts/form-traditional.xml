        <!-- Form which defines the first page/section of the "traditional" DSpace submission process,
             often used when depositing normal Items (i.e. Items which are not Entities). -->
        <form name="traditionalpageone">
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>contributor</dc-element>
                    <dc-qualifier>author</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Autor</label>
                    <input-type>onebox</input-type>
                    <hint>Wpisz nazwisko i imię autora.</hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>title</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Tytuł</label>
                    <input-type>onebox</input-type>
                    <hint>Wpisz tytuł publikacji.</hint>
                    <required>Musisz wpisać tytuł.</required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>title</dc-element>
                    <dc-qualifier>alternative</dc-qualifier>
                    <language value-pairs-name="common_iso_languages">true</language>
                    <repeatable>true</repeatable>
                    <label>Tytuł alternatywny</label>
                    <input-type>onebox</input-type>
                    <hint>Wpisz alternatywny tytuł i wybierz jego język.</hint>
                    <required></required>
                </field>
            </row>
            <!-- DOI -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>identifier</dc-element>
                    <dc-qualifier>doi</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>DOI</label>
                    <input-type>onebox</input-type>
                    <hint>Wpisz identyfikator DOI (np. 10.1000/xyz123).</hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>date</dc-element>
                    <dc-qualifier>issued</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Data publikacji</label>
                    <style>col-sm-4</style>
                    <input-type>date</input-type>
                    <hint>Podaj datę publikacji lub upublicznienia, jeżeli ta pozycja była wcześniej
                        publikowana gdzieś indziej. Możesz pominąć miesiąc i dzień.
                    </hint>
                    <required>Pole wymagane - wpisz przynajmniej rok.</required>
                </field>

                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>publisher</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Wydawca</label>
                    <style>col-sm-8</style>
                    <input-type>onebox</input-type>
                    <hint>Podaj nazwę wydawcy, jeżeli ta pozycja była już gdzieś wcześniej opublikowana.</hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>identifier</dc-element>
                    <dc-qualifier>citation</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Cytowanie</label>
                    <input-type>onebox</input-type>
                    <hint>Podaj standardową formę cytowania dla tej pozycji, jeżeli ta pozycja była
                        wcześniej gdzieś opublikowana.</hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>relation</dc-element>
                    <dc-qualifier>ispartofseries</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Numer serii/raportu</label>
                    <input-type>series</input-type>
                    <hint>Podaj serię i numer, jeżeli pozycja takowe posiada. </hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>identifier</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <!-- An input-type of qualdrop_value MUST be marked as repeatable -->
                    <repeatable>true</repeatable>
                    <label>Identyfikatory</label>
                    <input-type value-pairs-name="common_identifiers">qualdrop_value</input-type>
                    <hint>Jeżeli ta pozycja ma jakieś numery identyfikacyjne lub kody, proszę wpisz je tutaj.
                    </hint>
                    <required></required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>type</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Rodzaj</label>
                    <input-type value-pairs-name="common_types">dropdown</input-type>
                    <hint>Wybierz rodzaj pozycji.
                    </hint>
                    <required>You must choose at least one type.</required>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>language</dc-element>
                    <dc-qualifier>iso</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Język</label>
                    <input-type value-pairs-name="common_iso_languages">dropdown</input-type>
                    <hint>Wybierz język dla głównej zawartości tej pozycji. Jeżeli języka nie ma na liście, wybierz
                        "Inny". Jeżeli dodajesz pozycję, która nie ma określonego języka (np. zbiór danych lub
                        obraz), wybierz "nie dotyczy".
                    </hint>
                    <required></required>
                </field>
            </row>

            <!-- ================================================================= -->
            <!-- TYPE-SPECIFIC FIELDS - pokazywane w zależności od wybranego typu -->
            <!-- ================================================================= -->

            <!-- BOOK CHAPTER: Tytuł książki nadrzędnej -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>relation</dc-element>
                    <dc-qualifier>ispartof</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Tytuł książki</label>
                    <type-bind>Book chapter</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Wpisz tytuł książki, w której znajduje się rozdział.</hint>
                    <required></required>
                </field>
            </row>
            <!-- BOOK CHAPTER: Redaktor książki -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>contributor</dc-element>
                    <dc-qualifier>editor</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Redaktor książki</label>
                    <type-bind>Book chapter</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Wpisz nazwisko i imię redaktora książki.</hint>
                    <required></required>
                </field>
            </row>

            <!-- ARTICLE: Tytuł czasopisma -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>relation</dc-element>
                    <dc-qualifier>ispartof</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Tytuł czasopisma</label>
                    <type-bind>Article</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Wpisz pełną nazwę czasopisma.</hint>
                    <required></required>
                </field>
            </row>
            <!-- ARTICLE: Tom, Zeszyt, Strony -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>bibliographicCitation</dc-element>
                    <dc-qualifier>volume</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Tom</label>
                    <style>col-sm-3</style>
                    <type-bind>Article</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Numer tomu.</hint>
                    <required></required>
                </field>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>bibliographicCitation</dc-element>
                    <dc-qualifier>issue</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Zeszyt/Numer</label>
                    <style>col-sm-3</style>
                    <type-bind>Article</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Numer zeszytu.</hint>
                    <required></required>
                </field>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>bibliographicCitation</dc-element>
                    <dc-qualifier>startPage</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Strona od</label>
                    <style>col-sm-3</style>
                    <type-bind>Article</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Pierwsza strona.</hint>
                    <required></required>
                </field>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>bibliographicCitation</dc-element>
                    <dc-qualifier>endPage</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Strona do</label>
                    <style>col-sm-3</style>
                    <type-bind>Article</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Ostatnia strona.</hint>
                    <required></required>
                </field>
            </row>

            <!-- THESIS: Promotor -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>contributor</dc-element>
                    <dc-qualifier>advisor</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Promotor</label>
                    <type-bind>Thesis</type-bind>
                    <input-type>onebox</input-type>
                    <hint>Wpisz nazwisko i imię promotora pracy.</hint>
                    <required></required>
                </field>
            </row>
            <!-- THESIS: Rodzaj pracy -->
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>type</dc-element>
                    <dc-qualifier>thesis</dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Rodzaj pracy dyplomowej</label>
                    <type-bind>Thesis</type-bind>
                    <input-type value-pairs-name="thesis_types">dropdown</input-type>
                    <hint>Wybierz rodzaj pracy dyplomowej.</hint>
                    <required></required>
                </field>
            </row>

        </form>

